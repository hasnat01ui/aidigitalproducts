# =============================================================================
# AUREVIA — Environment variables
# =============================================================================
# Copy to .env.local and fill in. NEVER commit .env.local.
#
# Rule of thumb: anything prefixed NEXT_PUBLIC_ is shipped to the browser and
# is effectively public. Everything else must stay server-only.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
# Absolute base URL, no trailing slash. Used for auth redirects, payment
# return URLs, sitemap, and canonical tags.
NEXT_PUBLIC_APP_URL=http://localhost:3000


# -----------------------------------------------------------------------------
# Supabase  (project: AI Digital Products / lbrhfocjonfxpbylsdip)
# -----------------------------------------------------------------------------
# Safe to expose. RLS is what protects the data, not the secrecy of this key.
NEXT_PUBLIC_SUPABASE_URL=https://lbrhfocjonfxpbylsdip.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# !! SERVER ONLY !!
# Bypasses ALL row level security. Never prefix with NEXT_PUBLIC_, never import
# into a client component, never commit. Used only in server routes that must
# write orders, payments, and product access after verifying a payment.
SUPABASE_SERVICE_ROLE_KEY=


# -----------------------------------------------------------------------------
# Safepay  (primary payment gateway)
# -----------------------------------------------------------------------------
# "sandbox" or "production". Development must never run against production.
SAFEPAY_ENVIRONMENT=sandbox

# Public/merchant identifier used when creating a checkout session.
SAFEPAY_API_KEY=

# !! SERVER ONLY !! Signs API requests to Safepay.
SAFEPAY_SECRET_KEY=

# !! SERVER ONLY !! Verifies inbound webhook authenticity. Without this the
# webhook endpoint must reject every request rather than trust it.
SAFEPAY_WEBHOOK_SECRET=


# -----------------------------------------------------------------------------
# AI provider
# -----------------------------------------------------------------------------
# !! SERVER ONLY !! All model calls are proxied through server routes so this
# key never reaches the browser.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5


# -----------------------------------------------------------------------------
# Transactional email
# -----------------------------------------------------------------------------
# !! SERVER ONLY !!
EMAIL_API_KEY=
EMAIL_FROM="AUREVIA <hello@aurevia.example>"


# -----------------------------------------------------------------------------
# Paddle  (international payment gateway — Merchant of Record)
# -----------------------------------------------------------------------------
# Handles non-PKR customers. Paddle becomes the legal seller of record and
# calculates, collects and remits EU VAT / UK VAT / US sales tax / GST across
# 30+ jurisdictions — which a Pakistani entity cannot do alone. That tax
# liability, not card processing, is why this second gateway exists.
# Cost: ~5% + $0.50 per transaction.

# "sandbox" or "production". Development must never run against production.
PADDLE_ENVIRONMENT=sandbox

# !! SERVER ONLY !! Paddle API key (Paddle > Developer Tools > Authentication).
PADDLE_API_KEY=

# !! SERVER ONLY !! Secret for the notification destination (pdl_ntfset_...).
# Without it the webhook endpoint rejects every request rather than trusting it.
PADDLE_WEBHOOK_SECRET=
